# ── Frontend (Vite) configuration ────────────────────────────────────────────
# Copy this file to .env.local and fill in your actual values.
# Get these from: https://supabase.com/dashboard → Project Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here

# Self-hosted Fastify AI backend URL. Defaults to same-origin /api (the
# office nginx proxies /api/* to the Fastify server). On Vercel deployments
# the api/ folder serverless functions serve the same routes.
# VITE_API_URL=https://your-backend.example.com/api

# ── AI Server (server/.env) configuration ────────────────────────────────────
# The self-hosted Fastify server (server/) reads these from server/.env
# (gitignored). Never prefix secrets with VITE_ — Vite bakes VITE_* vars
# into the public JS bundle.

# OpenRouter API key — required, server-side only. Get one at:
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...
# Model id (default "openrouter/free" — the Free Models Router, free inference).
# Set OPENROUTER_MODEL=openrouter/auto for paid auto-routing, or any model
# slug such as moonshotai/kimi-k2 for a specific model.
# OPENROUTER_MODEL=openrouter/free
# OpenAI-compatible base (default "https://openrouter.ai/api/v1").
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Listen settings (defaults: PORT=8787, HOST=127.0.0.1).
# PORT=8787
# HOST=127.0.0.1
# Allowed browser origin(s), comma-separated. Default "http://localhost:5173".
# In production set this to your app origin(s) — never "*".
# CORS_ORIGIN=https://app.yourdomain.com
# Supabase project JWT secret (Project Settings → API → JWT Secret).
# When set, /api/ai/* requires a valid Supabase access token
# (Authorization: Bearer). REQUIRED for production — these endpoints run
# paid model calls.
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Rate limit for /api/ai/* per IP per window (default 10 / 60s).
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=60000

# ── Vercel serverless functions (api/) ───────────────────────────────────────
# Set these in the Vercel project environment variables (not in .env.local):
#   OPENROUTER_API_KEY  (required for api/ai/* on Vercel)
#   OPENROUTER_MODEL    (optional, default "openrouter/free")
#   PROXY_CORS_ORIGIN    (optional, comma-separated origins for /api/proxy-image)
