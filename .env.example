# Supabase configuration
# Copy this file to .env.local and fill in your actual values
# Get these from: https://supabase.com/dashboard → Project Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here

# ── OCR Provider Configuration (Phase 1 — Unlimited-OCR Integration) ──

# Which OCR provider to use. Options:
#   huggingface   — HuggingFace Inference API (Unlimited-OCR by default)
#   openai-vision — OpenAI GPT-4o / GPT-4 Vision
#   claude-vision — Anthropic Claude Vision
#   custom        — Your own OCR endpoint (set VITE_OCR_ENDPOINT)
VITE_OCR_PROVIDER=huggingface

# ── HuggingFace Provider ──────────────────────────────────────────────

# HuggingFace API token (required for Unlimited-OCR via Inference API)
# Get one at: https://huggingface.co/settings/tokens
VITE_HF_TOKEN=hf_your_token_here

# HuggingFace model (default: baidu/Unlimited-OCR)
# Alternatives: microsoft/trocr-large-printed, microsoft/trocr-base-handwritten
VITE_HF_OCR_MODEL=baidu/Unlimited-OCR

# Custom HuggingFace Inference Endpoint URL (overrides the default API)
# Use this if you deployed Unlimited-OCR to a dedicated HF Endpoint
# VITE_HF_OCR_ENDPOINT=https://your-endpoint.us-east-1.aws.endpoints.huggingface.cloud

# ── OpenAI Vision Provider ────────────────────────────────────────────

# OpenAI API key (for GPT-4o / GPT-4 Vision OCR)
# VITE_OPENAI_API_KEY=sk-your-key-here

# OpenAI model to use for OCR
# VITE_OPENAI_OCR_MODEL=gpt-4o

# ── Claude Vision Provider ────────────────────────────────────────────

# Anthropic API key (for Claude Vision OCR)
# VITE_CLAUDE_API_KEY=sk-ant-your-key-here

# Claude model to use for OCR
# VITE_CLAUDE_OCR_MODEL=claude-3-5-sonnet-20241022

# ── Custom Provider ───────────────────────────────────────────────────

# Custom OCR endpoint URL (used when VITE_OCR_PROVIDER=custom)
# Must accept POST with { image: base64_string, prompt: string }
# VITE_OCR_ENDPOINT=https://your-ocr-service.com/api/ocr

# API key for custom endpoint
# VITE_OCR_API_KEY=your-custom-api-key

# ── Backend Routing ───────────────────────────────────────────────────

# Set to 'true' to use the self-hosted Fastify backend at /api/ai/*
# instead of the Vercel serverless functions at /api/ai-ocr etc.
# VITE_OCR_USE_FASTIFY_BACKEND=false
