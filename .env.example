# ── Frontend (Vite) configuration ────────────────────────────────────────────
# These are baked into the browser bundle at build time (public by design).
# Local dev: copy to .env.local and fill in your values.
# Production (Render): they live in .env.production (see that file).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here

# Self-hosted API base. Defaults to same-origin /api — on Render the same
# container serves the SPA and the API, so leave this unset in production.
# VITE_API_URL=https://your-backend.example.com/api

# ── Server (server/) configuration ──────────────────────────────────────────
# The server reads these from server/.env (gitignored) or Render env vars.
# Never prefix secrets with VITE_ — Vite bakes VITE_* vars into the bundle.

# Supabase project JWT secret (Project Settings → API → JWT Secret).
# When set, /api/ai/* requires a valid Supabase access token
# (Authorization: Bearer). REQUIRED for production.
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Local PaddleOCR engine (no external API keys needed).
# OCR_MODEL_PRESET     v6-tiny | v6-small (default) | v6-medium | v5-* presets
# OCR_ENGINE           canvas-native (default, lighter) | opencv
# OCR_MIN_CONFIDENCE   drop recognitions below this score (default 0.4)
# OCR_MODEL_PRESET=v6-small
# OCR_ENGINE=canvas-native
# OCR_MIN_CONFIDENCE=0.4

# Listen settings. Render injects PORT automatically; keep HOST=0.0.0.0 in
# containers. For local dev: PORT=8787, HOST=127.0.0.1.
# PORT=8787
# HOST=127.0.0.1

# Allowed browser origin(s), comma-separated. Default "http://localhost:5173".
# In production set this to your app origin(s) — never "*".
# CORS_ORIGIN=https://app.yourdomain.com

# Directory with the built SPA (served at / with SPA fallback).
# Default ../dist — correct for local dev; Render sets STATIC_DIR=/app/client.
# STATIC_DIR=../dist

# Rate limit for /api/ai/* per IP per window (default 10 / 60s).
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=60000
