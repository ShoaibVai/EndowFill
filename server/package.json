{
  "name": "endowfill-server",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "EndowFill backend - local PaddleOCR ONNX OCR, rule-based extraction and form-field detection. No external API keys.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "jose": "^5.10.0",
    "jpeg-js": "^0.4.4",
    "onnxruntime-node": "^1.29.0",
    "pngjs": "^7.0.0",
    "ppu-paddle-ocr": "^6.4.3"
  },
  "devDependencies": {
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^24.12.2",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
